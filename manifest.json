{
  "name": "CineTrakt",
  "description": "Ajoute des boutons Stremio/Trakt et les couleurs IMDb/Trakt.",
  "version": "0.4.54",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "js": ["trakt-seasons-native.js"],
      "matches": ["https://app.trakt.tv/shows/*"]
    },
    {
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "js": ["trakt-collection-utils.js", "trakt-collection-native.js"],
      "matches": ["https://app.trakt.tv/movies/*"]
    },
    {
      "run_at": "document_start",
      "css": [
        "theme.css",
        "trakt-early.css",
        "trakt-seasons.css"
      ],
      "js": [
        "settings.js",
        "poster-layout-utils.js",
        "trakt-bootstrap.js",
        "trakt-native-section.js",
        "trakt-season-selector.js"
      ],
      "matches": [
        "https://app.trakt.tv/*"
      ]
    },
    {
      "run_at": "document_start",
      "all_frames": true,
			"css": ["trakt-posters.css", "trakt-horizontal-scroll.css"],
			"js": ["settings.js", "trakt-appearance.js", "trakt-horizontal-scroll.js"],
      "matches": ["https://app.trakt.tv/*"]
    },
    {
      "run_at": "document_idle",
      "css": ["theme.css"],
      "js": [
        "settings.js",
        "rating-utils.js",
        "extension-protocol.js",
        "dom-runtime.js",
        "imdb-runtime.js",
        "imdb-page.js",
        "imdb-episode-data.js",
        "imdb-trakt-button.js",
        "imdb-ratings.js",
        "imdb.js"
      ],
      "matches": [
        "https://www.imdb.com/title/*",
        "https://www.imdb.com/*/title/*"
      ]
    },
    {
      "run_at": "document_end",
      "js": [
        "rating-utils.js",
        "extension-protocol.js",
        "stremio-url.js",
        "stremio-open.js",
        "trakt-imdb-resolver.js",
        "season-rating-utils.js",
        "episode-rating-utils.js",
        "trakt-season-cards.js",
        "trakt-imdb-panel.js",
        "trakt-season-chart.js",
        "trakt-imdb-cache.js",
        "spotify-protocol.js",
        "dom-runtime.js",
        "trakt-runtime.js",
        "trakt-stremio-ui.js",
        "trakt-ratings.js",
        "trakt-poster-layout.js",
        "trakt-fanart.js",
        "tmdb-utils.js",
        "tmdb-artwork.js",
        "trakt-artwork.js",
        "trakt-soundtrack-library.js",
        "trakt-soundtrack.js",
        "trakt-collection-utils.js",
        "trakt-customizations.js",
        "trakt.js"
      ],
      "matches": [
        "https://app.trakt.tv/*"
      ]
    },
    {
      "run_at": "document_idle",
      "css": ["theme.css"],
      "js": [
        "settings.js",
        "stremio-formatting.js",
        "stremio-badges.js",
        "extension-protocol.js",
        "stremio.js"
      ],
      "matches": [
        "https://web.stremio.com/*"
      ]
    },
    {
      "run_at": "document_idle",
      "all_frames": true,
      "js": [
        "settings.js",
        "spotify-protocol.js",
        "spotify-playback.js",
        "spotify-embed.js"
      ],
      "matches": [
        "https://open.spotify.com/embed*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/ratings/*.svg"],
      "matches": ["https://app.trakt.tv/*"]
    },
    {
      "resources": ["assets/trakt-logo.svg"],
      "matches": ["https://www.imdb.com/*"]
    },
    {
      "resources": ["assets/stream-badges/*.png", "assets/stream-badges/*.svg", "assets/stream-providers/*.png"],
      "matches": ["https://web.stremio.com/*"]
    }
  ],
  "permissions": [
    "tabs",
    "system.display",
    "storage"
  ],
  "host_permissions": [
    "https://app.trakt.tv/*",
    "https://api.trakt.tv/*",
    "https://web.stremio.com/*",
    "https://www.imdb.com/*",
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*"
  ],
  "icons": {
    "16": "assets/icons/cinetrakt-16.png",
    "32": "assets/icons/cinetrakt-32.png",
    "48": "assets/icons/cinetrakt-48.png",
    "128": "assets/icons/cinetrakt-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/cinetrakt-16.png",
      "32": "assets/icons/cinetrakt-32.png",
      "48": "assets/icons/cinetrakt-48.png",
      "128": "assets/icons/cinetrakt-128.png"
    },
    "default_title": "CineTrakt"
  }
}
